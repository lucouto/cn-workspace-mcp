# cn-workspace-mcp — Coolify environment (copy into the app's Environment Variables).
# Fixed production settings live in Dockerfile.cn; only per-deployment values and
# secrets go here. Mark every line tagged SECRET as "secret" in Coolify.

# --- Public URL (must match the Coolify domain, HTTPS via Traefik) -----------
WORKSPACE_EXTERNAL_URL=https://gws.mcp.cheminneuf.community
GOOGLE_OAUTH_REDIRECT_URI=https://gws.mcp.cheminneuf.community/oauth2callback

# --- Google OAuth client (GCP → Google Auth Platform → Clients) --------------
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=                                   # SECRET

# Signs FastMCP tokens AND derives the encryption key of the session store.
# Generate once: openssl rand -base64 48   — rotating it signs everyone out.
FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY=                   # SECRET

# --- Who may connect (docs/PLAN.md §6) ---------------------------------------
# All three are Google Workspace domains (confirmed 2026-09-23), so the hd check applies.
CN_ALLOWED_DOMAINS=cheminneuf.community,chemin-neuf.org,wyd2027.org
# Individual gmail.com (or other) addresses, comma-separated. Only these: gmail.com
# as a whole is NOT allowed (anyone can create one; each user uses one of the
# 100 lifetime slots of an External app).
CN_ALLOWED_EMAILS=
# Must stay empty: every allowed domain is on Workspace.
CN_ALLOWED_DOMAINS_WITHOUT_HD=

# --- Only Claude may register as an OAuth client ------------------------------
# Per claude.com/docs/connectors/building/authentication (checked 2026-09-23):
# hosted Claude (web, Desktop, mobile, Cowork) uses exactly the first URI;
# Claude Code uses an RFC 8252 loopback redirect on a random port (the two
# patterns). Drop the loopback entries if Claude Code access isn't wanted.
# Applies to both DCR and CIMD clients.
WORKSPACE_MCP_ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost:*/callback,http://127.0.0.1:*/callback

# --- Optional: OCR (Azure AI Document Intelligence), off until the resource exists
# CN_DI_ENABLED=true
# CN_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# CN_DI_KEY=                                                  # SECRET
# CN_DI_DAILY_PAGES_PER_USER=200
